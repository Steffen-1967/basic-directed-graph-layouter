{
  "name": "mylife-app",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "build": "tsc",
    "start": "ts-node src/index.ts",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:debug": "playwright test --debug",
    "test:report": "playwright show-report",
    "test:with-server": "concurrently -k -s first \"npm run server:dev\" \"npx wait-on http://localhost:3000 && npm test\"",
    "server": "node server/server.js",
    "server:dev": "nodemon server/server.js",
    "dev": "concurrently \"npm run server:dev\" \"timeout /t 2 /nobreak && start http://localhost:3000\"",
    "generate": "ts-node src/index.ts && echo HTML generated in /out"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/node": "^25.5.0",
    "concurrently": "^9.2.1",
    "nodemon": "^3.1.14",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "express": "^5.2.1",
    "ws": "^8.18.0"
  }
}
