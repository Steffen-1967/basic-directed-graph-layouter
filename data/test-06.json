        {
          "id": "53fcb912-e436-4940-4f01-9ca9a4b4d417",
          "versionable": "independently",
          "version": "1.0",
          "type": "SubProcess",
          "name": [
            {
              "lcid": 1031,
              "value": "Ausweis beantragen"
            }
          ],
          "description": [
            {
              "lcid": 1031,
              "value": "Wird der erste [icon:file][Personalausweis][gloss.doc.idcard] für eine volljährige [icon:user-round][Person][gloss.role.person] beantragt, ist eine [icon:file][Geburtsurkunde][gloss.doc.birthcert] erforderlich. Wird der [icon:file][Personalausweis][gloss.doc.idcard] für eine minderjährige [icon:user-round][Person][gloss.role.person] beantragt, ist der [icon:file][Personalausweis][gloss.doc.idcard] eines [icon:user-round][Elternteils][gloss.role.parent] erforderlich. Wird ein Ersatz-[icon:file][Personalausweis][gloss.doc.idcard] bei Verlust beantragt, sind eine [icon:file][Geburtsurkunde][gloss.doc.birthcert] und eine [icon:file][Meldebescheinigung][gloss.doc.residcert] erforderlich. Wird der erste [Reisepass][gloss.doc.pass] beantragt, ist ein [Personalausweis][gloss.doc.idcard] erforderlich. Wird ein Folge-[icon:file][Personalausweis][gloss.doc.idcard] oder ein Folge-[icon:file][Reisepass][gloss.doc.pass] beantragt, ist der [icon:file][Personalausweis][gloss.doc.idcard] oder der [icon:file][Reisepass][gloss.doc.pass] erforderlich.\n\n[gloss.role.person]: http://mylife.org/Person\n[gloss.role.parent]: http://mylife.org/Parent\n[gloss.doc.idcard]: http://mylife.org/IdCard\n[gloss.doc.pass]: http://mylife.org/Pass\n[gloss.doc.birthcert]: http://mylife.org/BirthCertificate\n[gloss.doc.residcert]: http://mylife.org/RegistrationCertificate"
            }
          ],
